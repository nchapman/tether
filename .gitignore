/target

# Prebuilt static FFmpeg staged by scripts/fetch-ffmpeg.sh (downloaded per host
# from the nchapman/tether-ffmpeg releases; never committed — `mise run ffmpeg`).
/vendor/ffmpeg/

# Engine sidecars staged for Tauri bundling by scripts/stage-engine-binaries.sh
# (copied from target/release per build; never committed).
/apps/tether-shell/src-tauri/binaries/

# Ad-hoc log captures from manual `cargo run` testing.
*.log

# Machine-specific mise overrides (FFmpeg paths, etc.).
mise.local.toml
