{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.3.2",
  "identifier": "app.tether.shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tether",
        "width": 420,
        "height": 560,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-tether-uinput.rules": "../../../packaging/linux/udev/60-tether-uinput.rules"
        },
        "postInstallScript": "../../../packaging/linux/postinst-udev.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-tether-uinput.rules": "../../../packaging/linux/udev/60-tether-uinput.rules"
        },
        "postInstallScript": "../../../packaging/linux/postinst-udev.sh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nchapman/tether/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMzQxMDBCMTFBREJFQUMKUldTc3ZxMFJDeEEwMzQ5aG1GZHl6RkdRU0JOYTZUL0F2alVWYVNrMnFrV3Zib1c3cGk3RDFLcmMK"
    }
  }
}
